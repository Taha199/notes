{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email == 'abdomar200@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'abdomar200@gmail.com')",
        ".indexOn": ["cloudSyncAt"]
      }
    }
  }
}
