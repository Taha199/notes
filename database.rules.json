{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email == 'abdomar200@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "presence": {
      ".read": "auth != null && auth.token.email == 'abdomar200@gmail.com'",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['lastSeen']) && newData.child('lastSeen').isNumber()"
      }
    },
    "platform": {
      "config": {
        ".read": true,
        ".write": false
      }
    }
  }
}
